// Add these matches INSIDE: match /databases/{database}/documents { ... }
// Do not replace your complete firestore.rules with this file.

match /users/{userId}/settings/{settingId} {
  allow read, write: if request.auth != null && request.auth.uid == userId;
}

match /users/{userId}/activity/{activityId} {
  allow read, create, delete: if request.auth != null && request.auth.uid == userId;
  allow update: if false;
}

match /users/{userId}/{listCollection}/{targetUid} {
  allow read, create, delete: if request.auth != null
    && request.auth.uid == userId
    && listCollection in ['closeFriends','restrictedAccounts','mutedAccounts','favourites'];
  allow update: if false;
}
